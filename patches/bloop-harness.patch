+/** Bloop's built client: both palettes, hover buffer, full button hit box, and a resident avatar. */
+import { mkdir } from 'node:fs/promises'
+import { chromium } from 'playwright'
+import { expect, it, onTestFinished } from 'vitest'
+import { launchWebScaffold, watchConsole } from './scaffold.ts'
+
+it.runIf(process.env.DSH_CLIENT_BLOOP === '1')('keeps Bloop glass translucent and history usable near New Task', async () => {
+  const scaffold = await launchWebScaffold({})
+  onTestFinished(() => scaffold.close())
+  const browser = await chromium.launch()
+  onTestFinished(() => browser.close())
+  const page = await browser.newPage({ viewport: { width: 1280, height: 900 }, locale: 'en-US' })
+  await page.addInitScript(() => {
+    const model = (name: string) => ({baseUrl: 'https://example.test/v1', model: name, hasKey: true})
+    const settings = {main: model('design-fixture'), vision: model('vision-fixture'), image: model('image-fixture')}
+    const capabilities = {visionConfigured: true, imageConfigured: false, restartRequired: false}
+    Object.defineProperty(globalThis, 'dshDesktop', {value: {protocolVersion: 1, bloop: {
+      request: async (operation: string) => JSON.stringify({ok: true,
+        ...(operation === 'settings' ? {settings, capabilities} : operation === 'session' ? {stage: 'thinking', phase: 'idle', images: [], article: null, capabilities} : {}),
+      }),
+    }}})
+  })
+  const console = watchConsole(page)
+  await page.goto(scaffold.authenticatedUrl, { waitUntil: 'load' })
+  await page.evaluate(() => { document.documentElement.dataset.platform = 'darwin' })
+  const frame = page.locator('[data-bloop][data-sidebar-collapsed]')
+  await frame.waitFor()
+  const avatar = await page.locator('[data-bloop-companion] svg').elementHandle()
+  expect(avatar).not.toBeNull()
+  const newTask = page.getByRole('button', { name: 'New Task', exact: true })
+  await page.mouse.move(16, 180)
+  await newTask.waitFor({ state: 'visible' })
+  await newTask.click({ trial: true })
+  const box = (await newTask.boundingBox())!
+  expect(box.height).toBeGreaterThanOrEqual(46)
+  // Traverse the button's whole width, including the extra pointer buffer.
+  for (const x of [box.x + 2, box.x + box.width - 2, 294, box.x + box.width / 2]) {
+    await page.mouse.move(x, box.y + box.height / 2)
+    await expect.poll(() => page.locator('[data-bloop][data-sidebar-collapsed]').count()).toBe(0)
+  }
+  await newTask.hover()
+  await page.waitForTimeout(700)
+  expect(await page.locator('[data-bloop][data-sidebar-collapsed]').count()).toBe(0)
+  expect(await newTask.evaluate(node => getComputedStyle(node).getPropertyValue('-webkit-app-region'))).toBe('no-drag')
+  for (const dark of [false, true]) {
+    await page.evaluate(value => { document.body.toggleAttribute('data-ds-dark-theme', value) }, dark)
+    const material = await page.locator('[data-bloop]').first().evaluate(frame => {
+      const column = frame.querySelector('[data-slot="sidebar"]')!.parentElement!
+      const center = frame.querySelector('[data-slot="main"]')!.parentElement!
+      return {
+        glass: getComputedStyle(column.querySelector('[aria-hidden=true]')!).backgroundColor,
+        blur: getComputedStyle(column.querySelector('[aria-hidden=true]')!).backdropFilter,
+        filterToken: getComputedStyle(column).getPropertyValue('--dsw-bloop-glass-filter'),
+        center: getComputedStyle(center).backgroundColor,
+        sidebar: getComputedStyle(column).backgroundColor,
+        conversation: getComputedStyle(frame.querySelector('[data-phase]')!).backgroundColor,
+      }
+    })
+    for (const fill of [material.glass, material.center]) {
+      expect(fill).toMatch(/^rgba\(/)
+      expect(Number(fill.slice(fill.lastIndexOf(',') + 1, -1)), JSON.stringify(material)).toBeGreaterThan(0)
+      expect(Number(fill.slice(fill.lastIndexOf(',') + 1, -1))).toBeLessThan(1)
+    }
+    expect(material.blur, JSON.stringify(material)).toContain('blur(56px)')
+    expect(material.sidebar).toBe('rgba(0, 0, 0, 0)')
+    expect(material.conversation).toBe('rgba(0, 0, 0, 0)')
+    await mkdir('.artifacts/bloop-glass', { recursive: true })
+    await page.screenshot({ path: `.artifacts/bloop-glass/${dark ? 'dark' : 'light'}.png` })
+  }
+  expect(await page.getByRole('dialog').count()).toBe(0)
+  expect(await page.getByText('Into the Unknown', {exact: true}).count()).toBe(0)
+  await page.getByRole('button', {name: 'Settings', exact: true}).click()
+  await page.getByRole('button', {name: 'Models', exact: true}).click()
+  expect(await page.getByText('DeepSeek Account', {exact: true}).count()).toBe(0)
+  await page.getByRole('tab', {name: 'Design model', exact: true}).waitFor()
+  await expect.poll(() => page.getByLabel('Model ID', {exact: true}).inputValue()).toBe('design-fixture')
+  await page.getByRole('tab', {name: 'Image model', exact: true}).click()
+  expect(await page.getByLabel('Model ID', {exact: true}).inputValue()).toBe('image-fixture')
+  await page.getByRole('tab', {name: 'Vision model', exact: true}).click()
+  expect(await page.getByLabel('Model ID', {exact: true}).inputValue()).toBe('vision-fixture')
+  await page.keyboard.press('Escape')
+  const composer = page.locator('[data-composer-input][contenteditable="true"]')
+  expect(await composer.getAttribute('data-placeholder')).not.toContain('/')
+  expect(await page.getByText('Usage and details', {exact: true}).count()).toBe(0)
+  expect(await page.locator('[data-composer-dock]').isVisible()).toBe(false)
+  expect(await page.getByRole('button', {name: /DeepSeek/}).count()).toBe(0)
+  await composer.fill('/')
+  await page.waitForTimeout(400)
+  expect(await page.getByRole('listbox').count()).toBe(0)
+  expect(await composer.innerText()).toBe('/')
+  await composer.fill('')
+  await page.mouse.move(16, 180)
+  await newTask.waitFor({state: 'visible'})
+  await newTask.click()
+  expect(await page.locator('[data-bloop][data-sidebar-collapsed]').count()).toBe(0)
+  expect(await page.locator('[data-bloop-companion] svg').evaluate((node, previous) => node === previous, avatar)).toBe(true)
+  await page.mouse.move(700, 500)
+  await expect.poll(() => page.locator('[data-bloop][data-sidebar-collapsed]').count()).toBe(1)
+  expect(console.pageErrors).toEqual([])
+})
