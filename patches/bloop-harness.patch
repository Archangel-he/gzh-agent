+/** Explicit image intent is persisted before either keyboard or button submission is enabled. */
+import { useEffect, useState } from 'react'
+import type { BloopAsset, BloopClient, BloopImage, BloopLabels } from '@deepseek-ai/dsh-client-ui-primitives'
+import css from './BloopMaterials.module.css'
+
+export function BloopMaterials({client, sessionId, names, labels, onBusy}: {
+  client: BloopClient; sessionId: string; names: readonly string[]; labels: BloopLabels; onBusy: (busy: boolean) => void
+}) {
+  const [images, setImages] = useState<BloopImage[]>(() => names.map(name => ({name, role: 'article'})))
+  const [assets, setAssets] = useState<BloopAsset[]>([])
+  const [busy, setBusy] = useState(true)
+  const [failed, setFailed] = useState(false)
+  useEffect(() => {
+    let active = true
+    onBusy(true)
+    void (async () => {
+      try {
+        const state = await client.request('session', {sessionId})
+        if (!active) return
+        const next = names.map((name, index) => state.images?.[index]?.name === name ? state.images[index]! : {name, role: 'article'})
+        setAssets(state.article?.assets ?? []); setImages(next)
+        await client.request('draft-images', {sessionId, images: next})
+        if (active) { setBusy(false); onBusy(false) }
+      } catch { if (active) { setFailed(true); setBusy(false) } }
+    })()
+    return () => { active = false }
+  }, [client, sessionId, names, onBusy])
+  const save = async (next: BloopImage[]) => {
+    setImages(next); setBusy(true); setFailed(false); onBusy(true)
+    try { await client.request('draft-images', {sessionId, images: next}); onBusy(false) }
+    catch { setFailed(true) }
+    finally { setBusy(false) }
+  }
+  return <fieldset className={css.materials} disabled={busy}>
+    <legend>{labels['bloop.materials']}</legend>
+    {images.map((image, index) => <div key={index}><span title={image.name}>{image.name}</span>
+      <select aria-label={`${image.name} · ${labels['bloop.materials']}`} value={image.role}
+        onChange={event => { void save(images.map((value, at) => at === index ? {...value, role: event.target.value} : value)) }}>
+        {(['article', 'reference', 'document'] as const).map(role => <option key={role} value={role}>{labels[role === 'article' ? 'bloop.articleRole' : role === 'reference' ? 'bloop.referenceRole' : 'bloop.documentRole']}</option>)}
+      </select>
+      {assets.length > 0 && <select aria-label={`${image.name} · ${labels['bloop.replaceImage']}`} value={image.replaceAssetId ?? ''}
+        onChange={event => { void save(images.map((value, at) => at === index ? {name: value.name, role: value.role, ...(event.target.value ? {replaceAssetId: event.target.value} : {})} : value)) }}>
+        <option value="">{labels['bloop.appendImage']}</option>
+        {assets.map(asset => <option key={asset.id} value={asset.id}>{labels['bloop.replaceImage']} · {asset.name}</option>)}
+      </select>}
+    </div>)}
+    <small>{labels['bloop.imageLimit']}</small>
+    {failed && <div role="alert">{labels['bloop.failed']} <button type="button" onClick={() => { void save(images) }}>{labels['bloop.retry']}</button></div>}
+  </fieldset>
+}
