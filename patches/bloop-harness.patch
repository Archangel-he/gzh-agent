+/** Public subset consumed from the bundled MIT bloub animation engine. */
+export interface BotFrame {
+  bodyPath: string
+  bodyAlpha: number
+  eyes: { d: string; matrix: string; alpha: number }[]
+  dots: { x: number; y: number; r: number; opacity: number; color?: string; depth?: number; d?: string; rot?: number }[]
+  dotsBehind: boolean
+  arcs: { id: string; front: string; back: string; width: number; opacity: number; grad: { x1: number; y1: number; x2: number; y2: number; stops: string[] } }[]
+  notif: { x: number; y: number; r: number } | null
+  notch: { x: number; y: number; r: number } | null
+}
+/** Upstream poses used by the continuous Bloop montage. */
+export type BotState = 'idle' | 'wink' | 'wide' | 'egg' | 'hexagon' | 'orbit' | 'swirl' | 'play' | 'comet' | 'thinking' | 'notify' | 'burst'
+/** Clock-free upstream SVG animation engine. */
+export class BotEngine {
+  /** Current upstream animation pose. */
+  readonly state: BotState
+  constructor(radius: number, state: BotState)
+  /**
+   * Blend into an upstream animation state without resetting elapsed time.
+   * @param state - next avatar pose.
+   * @param time - absolute animation time in seconds.
+   */
+  setState(state: BotState, time: number): void
+  /**
+   * Sample deterministic SVG geometry at an absolute time.
+   * @param time - animation time in seconds.
+   * @returns body and eye paths for this frame.
+   */
+  sample(time: number): BotFrame
+}
