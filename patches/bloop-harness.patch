@@ -0,0 +1,67 @@
+/** Separate image/vision services inside the existing Models page; stored keys are never returned. */
+import { useEffect, useState, useId } from 'react'
+import { SegmentedControl } from './SegmentedControl.tsx'
+import { Input } from './Input.tsx'
+import { Switch } from './Switch.tsx'
+import { Button } from './Button.tsx'
+import type { BloopClient, BloopLabels, BloopModel } from './bloop-desktop.ts'
+import css from './Bloop.module.css'
+
+/** Render the Bloop desktop controls using caller-owned native operations and labels. */
+export function BloopModelSettings({ client, labels }: { client: BloopClient; labels: BloopLabels }) {
+  const [config, setConfig] = useState<{ main: BloopModel; vision: BloopModel; image: BloopModel }>()
+  const [draft, setDraft] = useState({ main: { baseUrl: '', model: '', apiKey: '', clearKey: false }, vision: { baseUrl: '', model: '', apiKey: '', clearKey: false }, image: { baseUrl: '', model: '', apiKey: '', clearKey: false } })
+  const [purpose, setPurpose] = useState<'main' | 'vision' | 'image'>('main')
+  const purposeId = useId()
+  const [pending, setPending] = useState(false)
+  const [notice, setNotice] = useState('')
+  useEffect(() => {
+    let live = true
+    void client.request('settings').then(reply => {
+      if (live && reply.settings) {
+        setConfig(reply.settings)
+        setDraft({ main: { ...reply.settings.main, apiKey: '', clearKey: false }, vision: { ...reply.settings.vision, apiKey: '', clearKey: false }, image: { ...reply.settings.image, apiKey: '', clearKey: false } })
+        if (reply.capabilities?.restartRequired) setNotice(labels['bloop.restart'])
+      }
+    }).catch(() => { if (live) setNotice(labels['bloop.failed']) })
+    return () => { live = false }
+  }, [client, labels['bloop.failed'], labels['bloop.restart']])
+  const save = async (): Promise<void> => {
+    setPending(true); setNotice('')
+    try {
+      const reply = await client.request('save-settings', {[purpose]: draft[purpose]})
+      if (reply.settings) setConfig(reply.settings)
+      setDraft(previous => ({...previous, [purpose]: {...previous[purpose], apiKey: '', clearKey: false}}))
+      setNotice(labels[reply.capabilities?.restartRequired ? 'bloop.restart' : 'bloop.saved'])
+    } catch { setNotice(labels['bloop.failed']) }
+    finally { setPending(false) }
+  }
+  return <section className={css.modelSettings} data-bloop-models>
+    <SegmentedControl id={purposeId} label={labels['bloop.capabilities']} value={purpose} disabled={pending}
+      options={[
+        {value: 'main', label: labels['bloop.designModel']},
+        {value: 'vision', label: labels['bloop.vision']},
+        {value: 'image', label: labels['bloop.imageService']},
+      ]} onChange={setPurpose} />
+    {([purpose] as const).map(kind => <fieldset key={kind} className={css.modelForm} disabled={pending || !config} aria-label={labels[kind === 'main' ? 'bloop.designModel' : kind === 'vision' ? 'bloop.vision' : 'bloop.imageService']}>
+      <div className={css.modelHeading}>
+        <h3>{labels[kind === 'main' ? 'bloop.designModel' : kind === 'vision' ? 'bloop.vision' : 'bloop.imageService']}</h3>
+        <span className={css.modelBadge} data-configured={Boolean(config?.[kind].hasKey)}>{config?.[kind].hasKey ? labels['bloop.configured'] : kind === 'vision' ? labels['bloop.inherit'] : labels['bloop.unconfigured']}</span>
+      </div>
+      <p className={css.modelDescription}>{labels[kind === 'main' ? 'bloop.designHelp' : kind === 'vision' ? 'bloop.visionHelp' : 'bloop.imageHelp']}</p>
+      {(['baseUrl', 'model', 'apiKey'] as const).map(field => <label key={field} className={css.modelField}>
+        {labels[field === 'baseUrl' ? 'bloop.baseUrl' : field === 'model' ? 'bloop.model' : 'bloop.apiKey']}
+        <Input className={css.modelInput ?? ''} type={field === 'apiKey' ? 'password' : 'text'} autoComplete="off" value={draft[kind][field]}
+          placeholder={field === 'baseUrl' ? 'https://api.example.com/v1' : field === 'model' ? 'model-id' : config?.[kind].hasKey ? labels['bloop.keepKey'] : undefined}
+          onChange={event => { const value = event.target.value; setDraft(previous => ({ ...previous, [kind]: { ...previous[kind], [field]: value } })) }} />
+      </label>)}
+      {config?.[kind].hasKey && <div className={css.modelKeyAction}><span>{labels['bloop.clearKey']}</span>
+        <Switch label={labels['bloop.clearKey']} checked={draft[kind].clearKey} onChange={checked => { setDraft(previous => ({...previous, [kind]: {...previous[kind], clearKey: checked}})) }} />
+      </div>}
+    </fieldset>)}
+    <div className={css.modelFooter}>
+      {notice && <p role="status">{notice}</p>}
+      <Button variant="primary" disabled={pending || !config} onClick={() => { void save() }}>{labels['bloop.saveSettings']}</Button>
+    </div>
+  </section>
+}
diff --git a/packages/client/ui-primitives/src/bloop-desktop.ts b/packages/client/ui-primitives/src/bloop-desktop.ts
new file mode 100644
index 00000000..a1407017
--- /dev/null
+++ b/packages/client/ui-primitives/src/bloop-desktop.ts
@@ -0,0 +1,101 @@
+/** Bloop's validated JSON bridge. Native preview documents never receive this capability. */
+/** One immutable article revision. */
+export interface BloopVersion { version: string; title: string; createdAt: string; preview: string; article: string; restorable: boolean }
+/** An article image available as a replacement target. */
+export interface BloopAsset { id: string; name: string; role: string; width: number; height: number }
+/** Validated article delivery and revision inventory. */
+export interface BloopArticle { directory: string; version: string; currentVersion: string; title: string; preview: string; article: string; legacy: boolean; versions: BloopVersion[]; assets: BloopAsset[]; warnings: string[] }
+/** User-selected intent of one draft attachment. */
+export interface BloopImage { name: string; role: string; replaceAssetId?: string }
+/** Presence of configured image services, not a connectivity guarantee. */
+export interface BloopCapabilities { visionConfigured: boolean; imageConfigured: boolean; restartRequired: boolean }
+/** Public service settings without the stored credential. */
+export interface BloopModel { baseUrl: string; model: string; hasKey: boolean }
+/** Validated payload returned by the trusted local bridge. */
+export interface BloopReply { article?: BloopArticle | null; capabilities?: BloopCapabilities; stage?: string; phase?: string; images?: BloopImage[]; settings?: { main: BloopModel; vision: BloopModel; image: BloopModel }; cancelled?: boolean }
+/** Native request capability injected into product components. */
+export interface BloopClient { request(operation: string, args?: object): Promise<BloopReply> }
+
+const record = (value: unknown): Record<string, unknown> => {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new Error('BLOOP_INVALID_RESPONSE')
+  return value as Record<string, unknown>
+}
+const string = (value: unknown): string => { if (typeof value !== 'string') throw new Error('BLOOP_INVALID_RESPONSE'); return value }
+const boolean = (value: unknown): boolean => { if (typeof value !== 'boolean') throw new Error('BLOOP_INVALID_RESPONSE'); return value }
+const number = (value: unknown): number => { if (typeof value !== 'number' || !Number.isFinite(value)) throw new Error('BLOOP_INVALID_RESPONSE'); return value }
+const list = <T>(value: unknown, parse: (item: unknown) => T): T[] => {
+  if (!Array.isArray(value) || value.length > 1000) throw new Error('BLOOP_INVALID_RESPONSE')
+  return value.map(parse)
+}
+function parseArticle(value: unknown): BloopArticle {
+  const item = record(value)
+  return {
+    directory: string(item['directory']), title: string(item['title']), version: string(item['version']), currentVersion: string(item['currentVersion']),
+    preview: string(item['preview']), article: string(item['article']), legacy: boolean(item['legacy']),
+    warnings: list(item['warnings'], string),
+    assets: list(item['assets'], value => { const asset = record(value); return { id: string(asset['id']), name: string(asset['name']), role: string(asset['role']), width: number(asset['width']), height: number(asset['height']) } }),
+    versions: list(item['versions'], value => { const revision = record(value); return { version: string(revision['version']), title: string(revision['title']), createdAt: string(revision['createdAt']), preview: string(revision['preview']), article: string(revision['article']), restorable: boolean(revision['restorable']) } }),
+  }
+}
+/** Read and validate every field consumed by Bloop UI.
+ * @param input - native JSON response.
+ * @returns decoded response or a classified failure.
+ */
+export function parseBloopReply(input: string): BloopReply {
+  const value = record(JSON.parse(input))
+  if (value['ok'] !== true) throw new Error(typeof value['message'] === 'string' ? value['message'] : 'BLOOP_OPERATION_FAILED')
+  const reply: BloopReply = {}
+  if (value['article'] !== undefined) reply.article = value['article'] === null ? null : parseArticle(value['article'])
+  if (value['stage'] !== undefined) reply.stage = string(value['stage'])
+  if (value['phase'] !== undefined) reply.phase = string(value['phase'])
+  if (value['cancelled'] !== undefined) reply.cancelled = boolean(value['cancelled'])
+  if (value['capabilities'] !== undefined) {
+    const caps = record(value['capabilities'])
+    reply.capabilities = { visionConfigured: boolean(caps['visionConfigured']), imageConfigured: boolean(caps['imageConfigured']), restartRequired: boolean(caps['restartRequired']) }
+  }
+  if (value['settings'] !== undefined) {
+    const settings = record(value['settings'])
+    const model = (value: unknown): BloopModel => { const row = record(value); return { baseUrl: string(row['baseUrl']), model: string(row['model']), hasKey: boolean(row['hasKey']) } }
+    reply.settings = { main: model(settings['main']), vision: model(settings['vision']), image: model(settings['image']) }
+  }
+  if (value['images'] !== undefined) reply.images = list(value['images'], value => {
+    const image = record(value)
+    return { name: string(image['name']), role: string(image['role']), ...(image['replaceAssetId'] === undefined ? {} : { replaceAssetId: string(image['replaceAssetId']) }) }
+  })
+  return reply
+}
+/** Resolve the preload extension at registration time.
+ * @returns the native client, or undefined in a browser.
+ */
+export function createBloopClient(): BloopClient | undefined {
+  const desktop: unknown = Reflect.get(globalThis, 'dshDesktop')
+  if (desktop === null || typeof desktop !== 'object') return undefined
+  const bridge: unknown = Reflect.get(desktop, 'bloop')
+  if (bridge === null || typeof bridge !== 'object') return undefined
+  const request: unknown = Reflect.get(bridge, 'request')
+  if (typeof request !== 'function') return undefined
+  return { async request(operation, args = {}) {
+    const result: unknown = await request(operation, JSON.stringify(args))
+    return parseBloopReply(string(result))
+  } }
+}
+
+/** Locale keys consumed by the shared Bloop controls. */
+export const BLOOP_LABEL_KEYS = ['bloop.retry', 'bloop.designModel', 'bloop.designHelp', 'bloop.visionHelp', 'bloop.imageHelp', 'bloop.preview', 'bloop.copy', 'bloop.save', 'bloop.versions', 'bloop.restore', 'bloop.legacy', 'bloop.copied', 'bloop.saved', 'bloop.restored', 'bloop.failed', 'bloop.imagesNotice', 'bloop.loading', 'bloop.version', 'bloop.vision', 'bloop.imageService', 'bloop.configured', 'bloop.unconfigured', 'bloop.baseUrl', 'bloop.model', 'bloop.apiKey', 'bloop.keepKey', 'bloop.saveSettings', 'bloop.restart', 'bloop.inherit', 'bloop.clearKey', 'bloop.capabilities', 'bloop.current', 'bloop.modified', 'bloop.articleRole', 'bloop.referenceRole', 'bloop.documentRole', 'bloop.appendImage', 'bloop.replaceImage', 'bloop.materials', 'bloop.imageLimit'] as const
+/** Complete caller-supplied labels for Bloop controls. */
+export type BloopLabels = Record<typeof BLOOP_LABEL_KEYS[number], string>
+/** Localized primitive copy.
+ * @param t - locale-owned lookup.
+ * @returns complete labels.
+ */
+export function bloopLabels(t: (key: typeof BLOOP_LABEL_KEYS[number]) => string): BloopLabels {
+  return Object.fromEntries(BLOOP_LABEL_KEYS.map(key => [key, t(key)])) as BloopLabels
+}
+
+/** Recognize only article outputs, not arbitrary user HTML.
+ * @param path - workspace or absolute file path.
+ * @returns whether the file is an article delivery.
+ */
+export function isBloopArticlePath(path: string): boolean {
+  return /(?:^|\/)gzh-output\/[a-f0-9-]{36}\/(?:revisions\/v\d{4,}\/|versions\/[\w.-]+\/)?(?:article|preview)\.html$/.test(path.replaceAll('\\', '/'))
+}
