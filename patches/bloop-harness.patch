diff --git a/packages/client/ui-conversation/src/client/bloop/BloopTaskPanel.tsx b/packages/client/ui-conversation/src/client/bloop/BloopTaskPanel.tsx
new file mode 100644
index 00000000..0d0ae47d
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/bloop/BloopTaskPanel.tsx
@@ -0,0 +1,42 @@
+/** Real task lifecycle and the latest successful delivery, independent of conversation prose. */
+import { useEffect, useState } from 'react'
+import type { BloopClient, BloopReply } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { TranslateNS } from '@deepseek-ai/dsh-client-ui-slots'
+import css from './BloopTaskPanel.module.css'
+
+const stages = ['thinking', 'preparing', 'vision', 'images', 'generating', 'checking', 'delivering', 'assets'] as const
+const phases = ['completed', 'waiting', 'error', 'stopped', 'idle'] as const
+
+export function BloopTaskPanel({client, sessionId, running, failed, waiting, hero, t}: {
+  client: BloopClient; sessionId: string; running: boolean; failed: boolean; waiting: boolean; hero: boolean;
+  t: TranslateNS<'conversation'>
+}) {
+  const [result, setResult] = useState<BloopReply>()
+  const [unavailable, setUnavailable] = useState(false)
+  useEffect(() => {
+    let active = true
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const poll = async () => {
+      if (!active) return
+      try {
+        if (document.visibilityState !== 'hidden') {
+          const next = await client.request('session', {sessionId})
+          if (active) { setResult(next); setUnavailable(false) }
+        }
+      } catch { if (active) setUnavailable(true) }
+      if (active) timer = setTimeout(() => { void poll() }, running ? 1500 : 5000)
+    }
+    void poll()
+    return () => { active = false; clearTimeout(timer) }
+  }, [client, sessionId, running])
+  const stage = stages.find(stage => stage === result?.stage) ?? 'thinking'
+  const phase = phases.find(phase => phase === result?.phase) ?? 'idle'
+  const label = failed ? t('bloop.status.error') : waiting ? t('bloop.status.waiting')
+    : running ? t(`bloop.status.${stage}`) : t(`bloop.status.${phase}`)
+  return <div className={css.panel} data-bloop-task>
+    {!hero && (running || failed || waiting || unavailable || phase !== 'idle') && <div role="status" aria-live="polite">{unavailable ? t('bloop.failed') : label}
+      {result?.article && <span>{t('bloop.current')} · {result.article.currentVersion}</span>}
+    </div>}
+    {hero && result?.capabilities?.imageConfigured === false && <small>{t('bloop.imageMissing')}</small>}
+  </div>
+}
