@@ -0,0 +1,97 @@
+import { useEffect, useId, useLayoutEffect, useRef, useState } from 'react'
+import type { SnapshotSelectorHook } from '@deepseek-ai/dsh-client-store'
+import { BotEngine } from './bloub.js'
+import css from './BloopCompanion.module.css'
+
+const MONTAGE = ['idle', 'wink', 'egg', 'orbit', 'wide', 'hexagon', 'swirl', 'play', 'thinking', 'notify', 'comet', 'burst'] as const
+
+/** One continuously mounted avatar; changing its position never resets its clock. */
+function BloopAvatar({mood, visible}: {mood: BloopCompanionSeat['mood']; visible: boolean}) {
+  const moodRef = useRef(mood)
+  moodRef.current = mood
+  const elapsedRef = useRef(0)
+  const [engine] = useState(() => new BotEngine(100, 'idle'))
+  const [frame, setFrame] = useState(() => engine.sample(0))
+  const mask = useId().replaceAll(':', '')
+  useEffect(() => {
+    if (!visible) return
+    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return
+    let request = 0
+    let origin: number | undefined
+    let last = -Infinity
+    let previous = ''
+    const animate = (now: number): void => {
+      origin ??= now
+      const elapsed = elapsedRef.current + (now - origin) / 1000
+      const poses = moodRef.current === 'working' ? ['thinking', 'orbit', 'swirl', 'hexagon'] as const
+        : moodRef.current === 'waiting' ? ['notify', 'wink', 'idle'] as const
+        : moodRef.current === 'error' ? ['egg', 'notify', 'thinking'] as const
+        : moodRef.current === 'done' ? ['burst', 'play', 'wink', 'comet'] as const : MONTAGE
+      const state = poses[Math.floor(elapsed / 2.8) % poses.length]!
+      if (state !== previous) { engine.setState(state, elapsed); previous = state }
+      if (now - last >= 32 && document.visibilityState !== 'hidden') { setFrame(engine.sample(elapsed)); last = now }
+      request = requestAnimationFrame(animate)
+    }
+    request = requestAnimationFrame(animate)
+    return () => { cancelAnimationFrame(request); if (origin !== undefined) elapsedRef.current += (performance.now() - origin) / 1000 }
+  }, [engine, visible])
+  const dots = frame.dots.map((dot, i) => dot.d
+    ? <path key={i} d={dot.d} transform={`translate(${dot.x} ${dot.y}) rotate(${dot.rot ?? 0}) scale(100)`} fill={dot.color ?? 'currentColor'} opacity={dot.opacity} />
+    : <circle key={i} cx={dot.x} cy={dot.y} r={dot.r} fill={dot.color ?? 'currentColor'} opacity={dot.opacity} />)
+  return <svg viewBox="-158 -158 316 316" aria-hidden="true" focusable="false" data-bloop-pose={engine.state}>
+    <defs><mask id={mask} maskUnits="userSpaceOnUse" x="-158" y="-158" width="316" height="316">
+      <path d={frame.bodyPath} fill="white" />
+      {frame.eyes.map((eye, i) => <path key={i} d={eye.d} transform={eye.matrix} opacity={eye.alpha} fill="black" />)}
+      {frame.notch && <circle cx={frame.notch.x} cy={frame.notch.y} r={frame.notch.r} fill="black" />}
+    </mask>
+      {frame.arcs.map(arc => <linearGradient key={arc.id} id={`${mask}-${arc.id}`} gradientUnits="userSpaceOnUse" x1={arc.grad.x1} y1={arc.grad.y1} x2={arc.grad.x2} y2={arc.grad.y2}>
+        {arc.grad.stops.map((color, i) => <stop key={i} offset={i / (arc.grad.stops.length - 1)} stopColor={color} />)}
+      </linearGradient>)}
+    </defs>
+    <g fill="none" strokeLinecap="round">{frame.arcs.map(arc => <path key={arc.id} d={arc.back} stroke={`url(#${mask}-${arc.id})`} strokeWidth={arc.width} opacity={arc.opacity} />)}</g>
+    {frame.dotsBehind && dots}
+    <path d={frame.bodyPath} fill="var(--dsw-alias-bg-base)" opacity={frame.bodyAlpha} />
+    <path d={frame.bodyPath} fill="currentColor" opacity={frame.bodyAlpha} mask={`url(#${mask})`} />
+    {!frame.dotsBehind && dots}
+    {frame.notif && <circle cx={frame.notif.x} cy={frame.notif.y} r={frame.notif.r} fill="#2496e8" />}
+    <g fill="none" strokeLinecap="round">{frame.arcs.map(arc => <path key={arc.id} d={arc.front} stroke={`url(#${mask}-${arc.id})`} strokeWidth={arc.width} opacity={arc.opacity} />)}</g>
+  </svg>
+}
+
+/**
+ * Keep the animated companion above the blank composer, then ease it to the window corner.
+ * @param props.hero - whether this conversation still awaits its first message.
+ * @param props.anchor - reserved avatar seat above the greeting and composer.
+ * @returns the persistent decorative avatar.
+ */
+export interface BloopCompanionSeat {
+  hero: boolean
+  mood?: 'idle' | 'working' | 'waiting' | 'error' | 'done' | undefined
+  anchor: HTMLDivElement | null
+}
+
+/** The frame owns this host so session changes never restart the avatar. */
+export function BloopCompanionHost({ useCompanion }: { useCompanion: SnapshotSelectorHook<BloopCompanionSeat | null> }) {
+  const seat = useCompanion(value => value)
+  return <BloopCompanion hero={seat?.hero ?? false} anchor={seat?.anchor ?? null} visible={seat !== null} mood={seat?.mood} />
+}
+
+export function BloopCompanion({ hero, anchor, mood, visible = true }: BloopCompanionSeat & { visible?: boolean }) {
+  const [point, setPoint] = useState({ x: 136, y: 78 })
+  useLayoutEffect(() => {
+    const measure = (): void => {
+      const rect = anchor?.getBoundingClientRect()
+      setPoint(hero && rect !== undefined ? { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 } : { x: 136, y: 78 })
+    }
+    measure()
+    const observer = new ResizeObserver(measure)
+    if (anchor !== null) {
+      observer.observe(anchor)
+      if (anchor.parentElement?.parentElement) observer.observe(anchor.parentElement.parentElement)
+    }
+    window.addEventListener('resize', measure)
+    return () => { observer.disconnect(); window.removeEventListener('resize', measure) }
+  }, [hero, anchor])
+  return <div className={css.companion} data-bloop-companion={hero ? 'hero' : 'corner'}
+    style={{ visibility: visible ? 'visible' : 'hidden', transform: `translate3d(${point.x}px, ${point.y}px, 0) translate(-50%, -50%) scale(${hero ? 1 : .44})` }}><BloopAvatar mood={mood} visible={visible} /></div>
+}
