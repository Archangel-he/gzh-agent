--- /dev/null
+++ b/packages/client/ui-conversation/tests/bloop-companion.client.spec.tsx
@@ -0,0 +1,90 @@
+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import { act, cleanup, render } from '@testing-library/react'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-test-runtime'
+import { useLayoutEffect } from 'react'
+import { BloopCompanion, BloopCompanionHost, type BloopCompanionSeat } from '../src/client/bloop/BloopCompanion.tsx'
+
+afterEach(() => { cleanup(); vi.unstubAllGlobals() })
+
+it('keeps the same animated SVG and clock when the first message docks the companion', () => {
+  let next = 0
+  const callbacks = new Map<number, FrameRequestCallback>()
+  const cancel = vi.fn((id: number) => { callbacks.delete(id) })
+  vi.stubGlobal('requestAnimationFrame', (fn: FrameRequestCallback) => { callbacks.set(++next, fn); return next })
+  vi.stubGlobal('cancelAnimationFrame', cancel)
+  vi.stubGlobal('ResizeObserver', class { observe() {} disconnect() {} })
+  const tick = (time: number): void => { act(() => {
+    const batch = [...callbacks.values()]; callbacks.clear(); batch.forEach(fn => { fn(time) })
+  }) }
+  const view = render(<BloopCompanion hero anchor={null} />)
+  const avatar = view.container.querySelector('svg')
+  tick(0)
+  tick(1000)
+  const before = avatar?.innerHTML
+  view.rerender(<BloopCompanion hero={false} anchor={null} />)
+  expect(view.container.querySelector('svg')).toBe(avatar)
+  expect(view.container.querySelector('[data-bloop-companion="corner"]')).not.toBeNull()
+  tick(3000)
+  expect(avatar?.innerHTML).not.toBe(before)
+  const poses = new Set<string | null>()
+  for (let time = 4000; time <= 36000; time += 2800) {
+    tick(time)
+    poses.add(avatar?.getAttribute('data-bloop-pose') ?? null)
+  }
+  expect(poses.size).toBeGreaterThanOrEqual(10)
+  view.unmount()
+  expect(callbacks.size).toBe(0)
+  expect(cancel).toHaveBeenCalled()
+})
+
+it('respects the system reduced-motion preference', () => {
+  const request = vi.fn()
+  vi.stubGlobal('requestAnimationFrame', request)
+  vi.stubGlobal('matchMedia', () => ({ matches: true }))
+  vi.stubGlobal('ResizeObserver', class { observe() {} disconnect() {} })
+  render(<BloopCompanion hero anchor={null} />)
+  expect(request).not.toHaveBeenCalled()
+})
+
+
+it('keeps the avatar in the corner and its clock running across conversation remounts', () => {
+  let next = 0
+  const callbacks = new Map<number, FrameRequestCallback>()
+  vi.stubGlobal('requestAnimationFrame', (fn: FrameRequestCallback) => { callbacks.set(++next, fn); return next })
+  vi.stubGlobal('cancelAnimationFrame', (id: number) => { callbacks.delete(id) })
+  vi.stubGlobal('ResizeObserver', class { observe() {} disconnect() {} })
+  const companion = createSnapshotStore<BloopCompanionSeat | null>(null)
+  const useCompanion = bindSnapshotSelector(companion)
+  function Conversation({ hero }: { hero: boolean }) {
+    useLayoutEffect(() => {
+      companion.set({ hero, anchor: null })
+      return () => { companion.set(null) }
+    }, [hero])
+    return null
+  }
+  const page = (id: string, hero = false) => <><Conversation key={id} hero={hero} /><BloopCompanionHost useCompanion={useCompanion} /></>
+  const view = render(page('new', true))
+  const avatar = view.container.querySelector('svg')!
+  const tick = (time: number): void => { act(() => {
+    const batch = [...callbacks.values()]; callbacks.clear(); batch.forEach(fn => { fn(time) })
+  }) }
+  tick(0)
+  tick(3000)
+  expect(avatar.dataset.bloopPose).toBe('wink')
+  view.rerender(page('history-a'))
+  expect(view.container.querySelector('svg')).toBe(avatar)
+  expect(avatar.dataset.bloopPose).toBe('wink')
+  const corner = view.container.querySelector<HTMLElement>('[data-bloop-companion="corner"]')!
+  expect(corner.style.transform).toContain('136px, 78px')
+  expect(corner.style.transform).toContain('scale(0.44)')
+  view.rerender(page('history-b'))
+  expect(view.container.querySelector('svg')).toBe(avatar)
+  expect(corner.style.transform).toContain('136px, 78px')
+  expect(corner.style.transform).toContain('scale(0.44)')
+  tick(6000)
+  expect(avatar.dataset.bloopPose).toBe('egg')
+  view.unmount()
+  expect(callbacks.size).toBe(0)
+})
