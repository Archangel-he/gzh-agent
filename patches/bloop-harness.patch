index 00000000..3861c9e8
--- /dev/null
+++ b/packages/client/ui-primitives/src/BloopArticleCard.tsx
@@ -0,0 +1,55 @@
+/** User-facing article delivery and fixed-version actions; native access arrives through props. */
+import { useEffect, useState } from 'react'
+import { Button } from './Button.tsx'
+import type { BloopArticle, BloopClient, BloopLabels } from './bloop-desktop.ts'
+import css from './Bloop.module.css'
+
+/** Render the Bloop desktop controls using caller-owned native operations and labels. */
+export function BloopArticleCard({ path, sessionId, client, labels, onPreview, compact = false }: {
+  path: string; sessionId: string; client: BloopClient; labels: BloopLabels; onPreview?: (path: string) => void; compact?: boolean
+}) {
+  const [article, setArticle] = useState<BloopArticle>()
+  const [attempt, setAttempt] = useState(0)
+  const [selected, setSelected] = useState('')
+  const [pending, setPending] = useState(false)
+  const [notice, setNotice] = useState('')
+  useEffect(() => {
+    let live = true
+    setArticle(undefined); setNotice('')
+    void client.request('article', { path, sessionId }).then(reply => {
+      if (!live) return
+      if (reply.article) { setArticle(reply.article); setSelected(reply.article.version) }
+      else setNotice(labels['bloop.failed'])
+    }).catch(() => { if (live) setNotice(labels['bloop.failed']) })
+    return () => { live = false }
+  }, [path, sessionId, client, labels['bloop.failed'], attempt])
+  const revision = article?.versions.find(version => version.version === selected)
+  const selectedPath = revision?.preview ?? article?.preview ?? path
+  const perform = async (operation: 'copy' | 'save' | 'restore'): Promise<void> => {
+    setPending(true); setNotice('')
+    try {
+      const reply = await client.request(operation, { path: selectedPath, sessionId, version: selected })
+      if (reply.article) { setArticle(reply.article); setSelected(reply.article.version); onPreview?.(reply.article.preview) }
+      if (!reply.cancelled) setNotice(labels[operation === 'copy' ? 'bloop.copied' : operation === 'save' ? 'bloop.saved' : 'bloop.restored'])
+    } catch { setNotice(labels['bloop.failed']) }
+    finally { setPending(false) }
+  }
+  return <section className={compact ? css.toolbar : css.card} data-bloop-article>
+    {!compact && <div className={css.identity}><strong>{article?.title ?? (notice ? labels['bloop.failed'] : labels['bloop.loading'])}</strong>
+      {article && <span>{labels['bloop.version']} {article.version}{article.legacy ? ` · ${labels['bloop.legacy']}` : ''}</span>}</div>}
+    {!article && notice && <Button size="sm" onClick={() => setAttempt(value => value + 1)}>{labels['bloop.retry']}</Button>}
+    <div className={css.actions}>
+      {onPreview && <Button size="sm" disabled={!article || pending} onClick={() => { onPreview(selectedPath) }}>{labels['bloop.preview']}</Button>}
+      <Button size="sm" disabled={!article || pending} onClick={() => { void perform('copy') }}>{labels['bloop.copy']}</Button>
+      <Button size="sm" disabled={!article || pending} onClick={() => { void perform('save') }}>{labels['bloop.save']}</Button>
+      {article && article.versions.length > 1 && <>
+        <select aria-label={labels['bloop.versions']} value={selected} disabled={pending} onChange={event => { setSelected(event.target.value); setNotice('') }}>
+          {article.versions.map(version => <option key={version.version} value={version.version}>{version.version}{version.version === article.currentVersion ? ` · ${labels['bloop.current']}` : ''}</option>)}
+        </select>
+        <Button size="sm" disabled={pending || !revision?.restorable || selected === article.currentVersion} onClick={() => { void perform('restore') }}>{labels['bloop.restore']}</Button>
+      </>}
+    </div>
+    <small>{labels['bloop.imagesNotice']}</small>
+    {notice && <div role="status" aria-live="polite">{notice}</div>}
+  </section>
+}
diff --git a/packages/client/ui-primitives/src/BloopModelSettings.tsx b/packages/client/ui-primitives/src/BloopModelSettings.tsx
