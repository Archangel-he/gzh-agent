diff --git a/apps/desktop/tests/bloop-desktop.spec.ts b/apps/desktop/tests/bloop-desktop.spec.ts
new file mode 100644
index 00000000..7fe133ee
--- /dev/null
+++ b/apps/desktop/tests/bloop-desktop.spec.ts
@@ -0,0 +1,39 @@
+/** Product-only native clipboard and save operations never trust an iframe or renderer output path. */
+import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { BrowserWindow, IpcMainInvokeEvent } from 'electron'
+import { DESKTOP_IPC } from '../src/ipc.ts'
+import { installBloopDesktop } from '../src/bloop.ts'
+const native = vi.hoisted(() => ({handlers: new Map<string, (...args: unknown[]) => Promise<string>>(), write: vi.fn(), has: vi.fn(), save: vi.fn()}))
+vi.mock('electron', () => ({
+  ipcMain: {handle: (name: string, handler: (...args: unknown[]) => Promise<string>) => {native.handlers.set(name, handler)}},
+  clipboard: {write: native.write, has: native.has},
+  ClipboardItem: class {constructor(readonly data: object) {}},
+  dialog: {showSaveDialog: native.save},
+}))
+afterEach(() => { vi.unstubAllEnvs(); vi.clearAllMocks(); native.handlers.clear() })
+it('rejects unowned requests, copies HTML atomically and writes only a native-dialog-selected file', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'bloop-ipc-'))
+  try {
+    await mkdir(join(root, 'lib'))
+    await writeFile(join(root, 'lib/desktop-ui.mjs'), `export const createDesktopUi = () => ({exported: async () => ({html:'<p>Article</p>',text:'Article',title:'Article',document:'<!doctype html><article>Article</article>'}), request: async () => ({})});`)
+    vi.stubEnv('GZH_DATA_DIR', join(root, 'data'))
+    const event = {} as IpcMainInvokeEvent
+    const assertSender = vi.fn((source: IpcMainInvokeEvent) => {if (source !== event) throw new Error('UNTRUSTED')})
+    installBloopDesktop(assertSender, () => ({} as BrowserWindow))
+    const request = native.handlers.get(DESKTOP_IPC.bloop)!
+    await expect(request({}, 'copy', '{}')).rejects.toThrow('UNTRUSTED')
+    await expect(request(event, 'copy', '[]')).rejects.toThrow('BLOOP_INVALID_REQUEST')
+    native.has.mockResolvedValue(true)
+    expect(JSON.parse(await request(event, 'copy', '{"path":"article"}')).ok).toBe(true)
+    expect(native.write).toHaveBeenCalledWith([expect.objectContaining({data: {'text/html': '<p>Article</p>', 'text/plain': 'Article'}})])
+    native.save.mockResolvedValueOnce({canceled: true})
+    expect(JSON.parse(await request(event, 'save', '{"path":"article"}')).cancelled).toBe(true)
+    const destination = join(root, 'export.html')
+    native.save.mockResolvedValueOnce({canceled: false, filePath: destination})
+    expect(JSON.parse(await request(event, 'save', '{"path":"article","destination":"/ignored"}')).ok).toBe(true)
+    expect(await readFile(destination, 'utf8')).toContain('<article>Article</article>')
+  } finally {await rm(root, {recursive: true, force: true})}
+})
