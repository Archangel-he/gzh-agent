+
+## Bloop 桌面流程
+
+Bloop 构建跳过原生欢迎和账号登录窗口，直接打开工作区；原生菜单与关于面板使用 Bloop 名称。独立维护的 Bloop 应用停用上游自动更新检查和强制厂商更新策略。仅产品主框架拥有 bloop IPC 扩展，请求验证后才加载本机业务服务；预览框架不获得剪贴板、保存对话框和模型设置能力。富文本复制使用 Electron ClipboardItem，保存必须经过原生保存对话框。
diff --git a/apps/desktop/src/bloop.ts b/apps/desktop/src/bloop.ts
new file mode 100644
index 00000000..0c11994e
--- /dev/null
+++ b/apps/desktop/src/bloop.ts
@@ -0,0 +1,50 @@
+/** Native operations for Bloop's locally installed article plugin; product frames only. */
+import { clipboard, ClipboardItem, dialog, ipcMain, type BrowserWindow, type IpcMainInvokeEvent } from 'electron'
+import { writeFile } from 'node:fs/promises'
+import { join, dirname } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { DESKTOP_IPC } from './ipc.ts'
+
+interface ArticleDesktopBackend {
+  request(operation: string, args: object): Promise<object>
+  exported(path: unknown): Promise<{ html: string; text: string; document: string; title: string }>
+}
+
+/** Install the trusted Bloop bridge without granting file or clipboard access to preview iframes. */
+export function installBloopDesktop(assertSender: (event: IpcMainInvokeEvent) => void, currentWindow: () => BrowserWindow | undefined): void {
+  const data = process.env.GZH_DATA_DIR
+  if (data === undefined) return
+  let backend: Promise<ArticleDesktopBackend> | undefined
+  const getBackend = (): Promise<ArticleDesktopBackend> => backend ??= import(pathToFileURL(join(dirname(data), 'lib/desktop-ui.mjs')).href)
+    .then(module => module.createDesktopUi(dirname(data)) as ArticleDesktopBackend)
+  ipcMain.handle(DESKTOP_IPC.bloop, async (event, operation: unknown, payload: unknown): Promise<string> => {
+    assertSender(event)
+    if (typeof operation !== 'string' || operation.length > 40 || typeof payload !== 'string' || payload.length > 32_768) throw new Error('BLOOP_INVALID_REQUEST')
+    const parsed: unknown = JSON.parse(payload)
+    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('BLOOP_INVALID_REQUEST')
+    try {
+      const api = await getBackend()
+      if (operation === 'copy' || operation === 'save') {
+        const output = await api.exported(Reflect.get(parsed, 'path'))
+        if (operation === 'copy') {
+          await clipboard.write([new ClipboardItem({ 'text/html': output.html, 'text/plain': output.text })])
+          if (!await clipboard.has('text/html')) throw new Error('BLOOP_CLIPBOARD_FAILED')
+          return JSON.stringify({ ok: true })
+        }
+        const parent = currentWindow()
+        if (parent === undefined) throw new Error('BLOOP_WINDOW_CLOSED')
+        const choice = await dialog.showSaveDialog(parent, {
+          defaultPath: output.title.replace(/[<>:"/\\|?*\x00-\x1f]/g, '_').slice(0, 100) + '.html',
+          filters: [{ name: 'HTML', extensions: ['html'] }],
+        })
+        if (choice.canceled || choice.filePath === undefined) return JSON.stringify({ ok: true, cancelled: true })
+        await writeFile(choice.filePath, output.document, 'utf8')
+        return JSON.stringify({ ok: true })
+      }
+      return JSON.stringify({ ok: true, ...await api.request(operation, parsed) })
+    } catch (error) {
+      // The plugin's validation errors contain fixed user-facing copy, never provider responses or keys.
+      return JSON.stringify({ ok: false, message: error instanceof Error ? error.message : 'BLOOP_OPERATION_FAILED' })
+    }
+  })
+}
