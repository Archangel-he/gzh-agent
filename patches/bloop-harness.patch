+// @vitest-environment jsdom
+/** Delivery actions retain selected immutable paths and reject malformed native payloads. */
+import { afterEach, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { BloopArticleCard } from '../src/BloopArticleCard.tsx'
+import { BloopModelSettings } from '../src/BloopModelSettings.tsx'
+import { bloopLabels, parseBloopReply, isBloopArticlePath, type BloopArticle } from '../src/bloop-desktop.ts'
+const labels = bloopLabels(key => key)
+const article: BloopArticle = {
+  directory: '/gzh-output/00000000-0000-0000-0000-000000000001', version: 'v0002', currentVersion: 'v0002', title: 'Article', article: 'v2/article.html', preview: 'v2/preview.html', legacy: false, warnings: [], assets: [],
+  versions: [1, 2].map(n => ({version: `v000${n}`, title: 'Article', createdAt: '', article: `v${n}/article.html`, preview: `v${n}/preview.html`, restorable: true})),
+}
+afterEach(cleanup)
+it('copies the chosen snapshot and restores without replacing an old delivery', async () => {
+  const request = vi.fn(async (operation: string) => operation === 'article' || operation === 'restore' ? {article} : {})
+  const preview = vi.fn()
+  render(<BloopArticleCard path="v2/preview.html" sessionId="s" client={{request}} labels={labels} onPreview={preview} />)
+  await screen.findByText('Article')
+  fireEvent.change(screen.getByRole('combobox'), {target: {value: 'v0001'}})
+  fireEvent.click(screen.getByRole('button', {name: 'bloop.copy'}))
+  await screen.findByText('bloop.copied')
+  expect(request).toHaveBeenLastCalledWith('copy', {path: 'v1/preview.html', sessionId: 's', version: 'v0001'})
+  fireEvent.click(screen.getByRole('button', {name: 'bloop.restore'}))
+  await screen.findByText('bloop.restored')
+  expect(request).toHaveBeenLastCalledWith('restore', {path: 'v1/preview.html', sessionId: 's', version: 'v0001'})
+  expect(preview).toHaveBeenCalledWith('v2/preview.html')
+})
+it('keeps API key inputs empty after loading and saving', async () => {
+  const settings = {main: {baseUrl: 'https://example.test/v1', model: 'design', hasKey: true}, vision: {baseUrl: 'https://example.test/v1', model: 'vision', hasKey: true}, image: {baseUrl: '', model: '', hasKey: false}}
+  const request = vi.fn(async (operation: string, args?: {image?: object}) => ({settings, capabilities: {visionConfigured: true, imageConfigured: false, restartRequired: operation === 'save-settings' && !args?.image}}))
+  render(<BloopModelSettings client={{request}} labels={labels} />)
+  await waitFor(() => expect((screen.getByRole('button', {name: 'bloop.saveSettings'}) as HTMLButtonElement).disabled).toBe(false))
+  const keys = screen.getAllByLabelText('bloop.apiKey')
+  expect(keys.every(key => (key as HTMLInputElement).value === '')).toBe(true)
+  fireEvent.change(keys[0]!, {target: {value: 'fixture-secret'}})
+  fireEvent.click(screen.getByRole('button', {name: 'bloop.saveSettings'}))
+  await screen.findByText('bloop.restart')
+  expect(keys.every(key => (key as HTMLInputElement).value === '')).toBe(true)
+  expect(request).toHaveBeenLastCalledWith('save-settings', {main: expect.objectContaining({model: 'design', apiKey: 'fixture-secret'})})
+  fireEvent.click(screen.getByRole('tab', {name: 'bloop.imageService'}))
+  expect((screen.getByLabelText('bloop.model') as HTMLInputElement).value).toBe('')
+  fireEvent.click(screen.getByRole('button', {name: 'bloop.saveSettings'}))
+  await screen.findByText('bloop.saved')
+  expect(request).toHaveBeenLastCalledWith('save-settings', {image: expect.objectContaining({apiKey: ''})})
+  fireEvent.click(screen.getByRole('tab', {name: 'bloop.vision'}))
+  expect((screen.getByLabelText('bloop.model') as HTMLInputElement).value).toBe('vision')
+})
+it('validates bridge fields and only recognizes article deliveries', () => {
+  expect(() => parseBloopReply('{"ok":true,"images":[{"role":3}]}')).toThrow('BLOOP_INVALID_RESPONSE')
+  expect(() => parseBloopReply('{"ok":false,"message":"failed"}')).toThrow('failed')
+  expect(isBloopArticlePath('/x/gzh-output/00000000-0000-0000-0000-000000000001/revisions/v0001/preview.html')).toBe(true)
+  expect(isBloopArticlePath('/x/arbitrary.html')).toBe(false)
+})
